8.20 spawn Embedded kind=hexstone @(708,499)
8.20 spawn Embedded kind=hexstone @(755,411)
8.23 -- unmade: status=running vitals=95.4 score=655 combo=6 counts=5/1/0/0 live=[Rot,Embedded,Embedded,Embedded]
"
`;

