exports[`Malison of Lauds > Call → Response: the bare heart "Wounded" past 65 % splits into two bodies joined by a light-thread 1`] = `
"2.02 initial LaudsMalison radius=42 hp=100 @(660,440)
2.05 cue burn
2.18 cue burn
2.23 cue burn
2.43 cue burn
2.52 cue burn
2.53 rate COOL "Silenced" +105 combo=1
2.65 flag brand-flesh
2.65 say "Careful! The brand is searing healthy flesh!"
2.65 say "instruction"
3.03 rate BAD "Scorched" +15 combo=0
3.03 spawn SimpleBurn @(758,443)
3.55 rate BAD "Scorched" +15 combo=0
3.55 spawn SimpleBurn @(737,448)
4.07 rate BAD "Scorched" +15 combo=0
4.07 spawn SimpleBurn @(762,458)
4.25 cue burn
4.33 cue burn
4.38 cue burn
4.42 cue burn
4.47 cue burn
4.67 cue burn
4.77 rate COOL "Silenced" +105 combo=1
5.27 rate BAD "Scorched" +15 combo=0
5.27 spawn SimpleBurn @(560,449)
5.78 rate BAD "Scorched" +15 combo=0
5.78 spawn SimpleBurn @(539,454)
6.30 rate BAD "Scorched" +15 combo=0
6.30 spawn SimpleBurn @(565,464)
6.70 cue burn
6.80 cue burn
6.95 cue burn
6.98 cue burn
7.00 rate COOL "Silenced" +105 combo=1
7.50 rate BAD "Scorched" +15 combo=0
7.50 spawn SimpleBurn @(722,436)
8.02 rate BAD "Scorched" +15 combo=0
8.02 spawn SimpleBurn @(701,441)
8.10 popup "White-hot! Let it cool."
8.10 flag overheat
8.10 say "The brand’s overheated. Give it a moment between searings."
8.10 say "instruction"
8.72 popup "The brand is too hot!"
10.38 cue burn
10.48 cue burn
10.62 cue burn
10.67 cue burn
10.67 rate COOL "Silenced" +105 combo=1
10.68 say "The choir is silenced — its heart is bare! Brand it, now!"
11.02 flag lauds-hymn
11.02 say "It’s singing — every verse tears him open! Stitch the cuts as they come!"
11.02 say "instruction"
11.02 cue sfx.lauds.hymn
11.23 cue burn
11.45 spawn LaudsBody radius=32.1 optional @(854,398)
11.45 spawn LightThread optional @(654,398)
11.45 say "It has split in two — and the halves sing to each other! Strike one, then the other, before it answers!"
11.45 rate GOOD "Wounded" +66 combo=2
11.45 -- split: status=running vitals=71.3 score=606 combo=2 counts=4/1/8/0 live=[LaudsMalison,SimpleBurn,SimpleBurn,SimpleBurn,SimpleBurn,SimpleBurn,SimpleBurn,SimpleBurn,SimpleBurn,LaudsBody,LightThread] phase="response" hp=65
"
`;

