exports[`Malison of Lauds > Dawn: submerged, found with the Lens, unmade into three hexstone shards 1`] = `
"2.02 initial LaudsMalison radius=33.6 hp=30 hidden @(660,440)
2.03 spawn BossRot r=26 @(660,440)
2.03 flag first-rot
2.03 say "Rot must be salved almost entirely — any island left creeps back."
2.03 say "instruction"
2.52 popup "Found it!"
2.52 flag lauds-surface
2.52 say "There! It’s surfacing — brand it before it dives!"
2.52 say "instruction"
2.83 -- found: status=running vitals=98.4 score=0 combo=0 counts=0/0/0/0 live=[DawnOverlay,LaudsMalison,BossRot] submerged=false
3.27 cue burn
3.42 cue burn
3.48 cue burn
3.50 cue burn
3.60 spawn BossDeath optional @(622,419)
3.60 rate COOL "Malison unmade" +105 combo=1
3.60 say "It shattered — hexstone, everywhere! Get every shard out before it spoils him!"
3.60 spawn Embedded kind=hexstone @(687,441)
3.60 flag first-hexstone
3.60 say "Hexstone: brand it still, then into the lead dish — never the tray."
3.60 say "instruction"
3.60 spawn Embedded kind=hexstone @(567,452)
3.60 spawn Embedded kind=hexstone @(614,365)
3.63 -- unmade: status=running vitals=97.9 score=105 combo=1 counts=1/0/0/0 live=[BossDeath,Embedded,Embedded,Embedded] alive=false
"
`;

