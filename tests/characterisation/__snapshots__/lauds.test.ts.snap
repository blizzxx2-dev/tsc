exports[`Malison of Lauds > each Voice is silenced by a 0.6 s brand hold (COOL "Silenced"); released, silence decays at 0.35/s 1`] = `
"1.20 initial LaudsMalison radius=42 hp=100 @(660,440)
2.02 -- partial silence: status=running vitals=98.3 score=0 combo=0 counts=0/0/0/0 live=[ChoirVoice,ChoirVoice,ChoirVoice,ChoirVoice,LaudsMalison] held=0.29 after=0.12
2.08 cue burn
2.23 cue burn
2.30 cue burn
2.32 cue burn
2.48 rate COOL "Silenced" +105 combo=1
2.48 flag brand-flesh
2.48 say "Careful! The brand is searing healthy flesh!"
"
`;

exports[`Malison of Lauds > full fight: silence the choir, wound it to half ("Wounded" → submerges), hunt it with the Lens, unmake it into three hexstone shards 1`] = `
