exports[`Malison of Matins > three phases: "Wounded" into the Watchfire (Litany taught) and The Eye; unmade on the third beat into three shards 1`] = `
"2.02 initial Malison hour=matins radius=50 hp=100 @(660,450)
6.03 flag malison-open
6.03 say "Its shroud has parted — sear it with the brand, now!"
6.03 say "instruction"
6.42 say "It’s quickening! Doctor — the Litany. Draw the star with the right hand and still the hour."
6.42 rate GOOD "Wounded" +63 combo=1
6.42 -- into the Watchfire: status=running vitals=97 score=63 combo=1 counts=0/1/0/0 live=[Malison] hp=60 phase="watchfire"
10.43 cue burn
10.58 cue burn
10.65 cue burn
10.67 cue burn
10.82 say "The shroud has burned away — an eye! Brand it on the third beat, and only then!"
10.82 rate GOOD "Wounded" +66 combo=2
10.82 -- the Eye opens: status=running vitals=95 score=129 combo=2 counts=0/2/0/0 live=[Malison] hp=25 phase="eye"
11.82 cue heartbeat
12.83 cue heartbeat
12.95 cue burn
13.02 spawn BossDeath optional @(541,387)
13.02 rate COOL "Malison unmade" +115 combo=3
13.02 spawn MalisonShard @(591,387)
13.02 spawn MalisonShard @(516,422)
13.02 spawn MalisonShard @(516,353)
13.02 say "It’s splitting apart! Seize every shard with the tongs and cast it out — before they rejoin!"
13.02 flag brand-flesh
13.02 say "Careful! The brand is searing healthy flesh!"
13.02 say "instruction"
13.05 -- unmade: status=running vitals=93.9 score=244 combo=3 counts=1/2/0/0 live=[BossDeath,MalisonShard,MalisonShard,MalisonShard] alive=false
"
`;
