exports[`Malison of Matins > Vigil rhythm: 4 s veiled, 2.5 s open; rends a boss wound every 4.5 s of veiled time 1`] = `
"2.02 initial Malison hour=matins radius=50 hp=100 @(660,450)
6.03 flag malison-open
6.03 say "Its shroud has parted — sear it with the brand, now!"
6.03 say "instruction"
9.05 spawn BossWound source=blade length=54 bleed=0.5 @(455,325)
9.05 cue cut
9.05 flag malison-rend
9.05 say "It’s tearing the flesh as it moves! Stitch those wounds!"
9.05 say "instruction"
13.05 spawn BloodPool ichor=blood r=8 optional @(454,322)
16.08 spawn BossWound source=blade length=54.6 bleed=0.5 @(614,364)
16.08 cue cut
20.08 spawn BloodPool ichor=blood r=8 optional @(617,364)
22.02 -- 20 s of rhythm: status=running vitals=83.7 score=0 combo=0 counts=0/0/0/0 live=[Malison,BossWound,BloodPool,BossWound,BloodPool] toggles=["open@4.03","veiled@6.55","open@10.57","veiled@13.08","open@17.10","veiled@19.62"]
"
`;

exports[`Malison of Matins > a shard dragged off the body is cast out (COOL); the rest rejoin after 9 s: MISS "It rejoined", 10 vitals, a weakened single-phase Malison 1`] = `
