exports[`barbed arrow > an object released while still on the body sinks back to its origin 1`] = `
"2.02 initial Embedded kind=bolt @(660,410)
2.02 cue pluck
2.17 flag drop-off
2.17 say "Right off the body, Doctor — into the tray, or it sinks back in."
2.17 say "instruction"
2.18 -- after a short pull: status=running vitals=98.9 score=0 combo=0 counts=0/0/0/0 live=[Embedded] back=true
"
`;

exports[`barbed arrow > pulling more than 18 px with fewer than two nicks tears: BAD "Torn", 8 vitals, a wound + 30 px laceration bleeding at 1.6, "barbs" said once 1`] = `
