// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`barbed arrow > an arrow released before it is clear (≤ 70 px) sinks back to its origin 1`] = `
"1.20 initial Embedded kind=bolt @(660,410)
1.20 cue pluck
1.33 -- after a short pull: status=running vitals=98.9 score=0 combo=0 counts=0/0/0/0 live=[Embedded] back=true
"
`;

exports[`barbed arrow > pulling more than 18 px with fewer than two nicks tears: BAD "Torn", 8 vitals, a wound + 30 px laceration bleeding at 1.6, "barbs" said once 1`] = `
"1.20 initial Embedded kind=arrow barbed @(600,410)
1.20 initial Embedded kind=arrow barbed @(780,450)
1.20 cue cut
1.20 rate GOOD "Nick" +63 combo=1
1.23 cue pluck
1.28 rate BAD "Torn" +15 combo=0
1.28 hurt 8
1.28 popup "-8"
1.28 spawn Laceration length=86 bleed=1.6 @(600,410)
1.28 flag barbs
1.28 say "Barbed! Nick the flesh at the entry with the lancet before you pull."
1.30 spawn BloodPool ichor=blood r=8 optional @(595,416)
1.50 -- after tearing the first: status=running vitals=90.5 score=78 combo=0 counts=0/1/1/0 live=[Embedded,Laceration,BloodPool]
1.50 cue pluck
1.55 rate BAD "Torn" +15 combo=0
1.55 hurt 8
1.55 popup "-8"
1.55 spawn Laceration length=86 bleed=1.6 @(780,450)
1.77 -- after tearing the second: status=running vitals=81.8 score=93 combo=0 counts=0/1/2/0 live=[Laceration,BloodPool,Laceration]
"
`;

