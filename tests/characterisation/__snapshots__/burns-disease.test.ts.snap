// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Bubo > a burst costs 10 vitals, pops "It burst!", spawns a pus pool and a 40 px laceration and counts a MISS 1`] = `
"2.02 initial Bubo r=22 @(660,410)
32.03 hurt 10
32.03 popup "-10"
32.03 popup "It burst!"
32.03 spawn BloodPool ichor=pus r=40 optional @(660,410)
32.03 spawn Laceration source=blade length=40 bleed=0.7 @(660,410)
32.03 flag pus-wound
32.03 say "The pus is getting into that cut — drain it before it festers!"
32.03 say "instruction"
32.03 -- burst: status=running vitals=73.7 score=0 combo=0 counts=0/0/0/1 live=[Bubo,BloodPool,Laceration] r=40.01
"
`;

exports[`Bubo > lancing a ripe bubo (≥ 75 % of max radius) is GOOD "Lanced" 1`] = `
"2.02 initial Bubo r=22 @(660,410)
15.35 -- ripe: status=running vitals=92.9 score=0 combo=0 counts=0/0/0/0 live=[Bubo] r=30
15.47 cue squelch
15.47 spawn BloodPool ichor=pus r=33.1 optional @(660,416)
15.47 rate GOOD "Lanced" +63 combo=1
"
`;

exports[`Bubo > lancing below 75 % of max radius is COOL "Lanced" and spills a pus pool; salving undrained pus says "pus"; drained (COOL) + salved is GOOD "Cleansed" 1`] = `
"2.02 initial Bubo r=22 @(660,410)
2.13 cue squelch
2.13 spawn BloodPool ichor=pus r=24.3 optional @(660,416)
2.13 rate COOL "Lanced" +105 combo=1
2.15 -- lanced: status=running vitals=98.9 score=105 combo=1 counts=1/0/0/0 live=[Bubo,BloodPool] r=22.07
2.15 flag pus
2.15 say "Draw off the pus before you salve it."
2.15 say "instruction"
3.40 cue squelch
3.40 rate COOL "Drained" +110 combo=2
4.08 rate GOOD "Cleansed" +69 combo=3
4.37 -- cleansed: status=running vitals=98.7 score=284 combo=3 counts=2/1/0/0 live=[]
"
`;

exports[`Burn > fire: salve first says burn-eschar; each pluck GOOD "Debrided"; last flake says burn-salve; full salve COOL "Burn dressed" 1`] = `
"2.02 initial Burn source=fire radius=44 @(660,410)
2.02 popup "The Saint’s Salve won’t help with the burn — try the Tongs."
2.02 rate BAD "Salve on eschar" +15 combo=0
2.02 flag burn-eschar
2.02 say "Pluck away the charred eschar with the tongs first!"
2.02 say "instruction"
2.78 -- salve before debriding: status=running vitals=98.6 score=15 combo=0 counts=0/0/1/0 live=[Burn] fraction=0
2.78 cue pluck
2.78 rate GOOD "Debrided" +63 combo=1
2.82 cue pluck
2.82 rate GOOD "Debrided" +66 combo=2
2.85 cue pluck
2.85 rate GOOD "Debrided" +69 combo=3
2.88 cue pluck
2.88 rate GOOD "Debrided" +72 combo=4
2.88 flag burn-salve
2.88 say "The dead flesh is off. Now salve the raw burn."
2.88 say "instruction"
2.92 -- debrided: status=running vitals=98.5 score=285 combo=4 counts=0/4/1/0 live=[Burn]
3.35 rate COOL "Burn dressed" +125 combo=5
3.68 -- dressed: status=running vitals=98.5 score=410 combo=5 counts=1/4/1/0 live=[]
"
`;

