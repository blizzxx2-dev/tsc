2.15 -- after stroke: status=running vitals=99 score=63 combo=1 counts=0/1/0/0 live=[Incision] state="open" progress=308.67
"
`;

exports[`Incision tracing > a stroke 20 px off the guide rates bad "Incision" 1`] = `
