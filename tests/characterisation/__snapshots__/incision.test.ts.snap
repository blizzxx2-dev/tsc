// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Incision tracing > a press away from the head of the line is not captured 1`] = `
"1.20 initial Incision @(510,470)
1.20 rate MISS +0 combo=0
1.20 hurt 3
1.20 popup "-3"
1.20 cue cut
1.53 -- after mid-line press: status=running vitals=96 score=0 combo=0 counts=0/0/0/1 live=[Incision]
"
`;

exports[`Incision tracing > a stroke 0 px off the guide rates cool "Incision" 1`] = `
"1.20 initial Incision @(510,470)
1.20 cue cut
2.10 rate COOL "Incision" +105 combo=1
2.10 cue squelch
2.15 -- after stroke: status=running vitals=99 score=105 combo=1 counts=1/0/0/0 live=[Incision] state="open" progress=308.75
"
`;

exports[`Incision tracing > a stroke 9 px off the guide rates good "Incision" 1`] = `
