exports[`Incision tracing > slipping more than 34 px off the line is BAD "Off the line", costs 2 vitals, and stops tracking until the next press 1`] = `
"1.20 initial Incision @(510,470)
1.20 cue cut
1.62 rate BAD "Off the line" +15 combo=0
1.62 hurt 2
1.62 popup "-2"
2.05 -- after slip: status=running vitals=97 score=15 combo=0 counts=0/0/1/0 live=[Incision] progress=110.38
2.05 cue cut
2.63 rate COOL "Incision" +105 combo=1
2.63 cue squelch
2.68 -- after resume: status=running vitals=97 score=120 combo=1 counts=1/0/1/0 live=[Incision] state="open"
"
`;

exports[`StitchLine closing > closing in one stroke rates COOL "Closed" 1`] = `
