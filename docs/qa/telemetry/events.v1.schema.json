{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suture-and-steel:telemetry:events:v1",
  "title": "Suture & Steel telemetry event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event",
    "ts",
    "session",
    "install",
    "seq",
    "build",
    "flavour",
    "props"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "event": {
      "enum": [
        "session_start",
        "consent_answered",
        "title_view",
        "new_game",
        "chapter_start",
        "op_start",
        "op_end",
        "op_fail",
        "rating",
        "tool_select",
        "story_skip",
        "settings_changed",
        "demo_end_view",
        "wishlist_click",
        "quit"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "install": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "build": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,40}$"
    },
    "flavour": {
      "enum": [
        "dev",
        "qa",
        "playtest",
        "release"
      ]
    },
    "props": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "session_start"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "os",
              "gpuFamily",
              "locale",
              "edition",
              "viewport"
            ],
            "properties": {
              "os": {
                "enum": [
                  "windows",
                  "macos",
                  "linux",
                  "steamos",
                  "other"
                ]
              },
              "gpuFamily": {
                "enum": [
                  "nvidia",
                  "amd",
                  "intel",
                  "apple",
                  "qualcomm",
                  "software",
                  "other",
                  "unknown"
                ]
              },
              "locale": {
                "type": "string",
                "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "edition": {
                "enum": [
                  "demo",
                  "full"
                ]
              },
              "viewport": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "w",
                  "h",
                  "dpr"
                ],
                "properties": {
                  "w": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "dpr": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "consent_answered"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "granted"
            ],
            "properties": {
              "granted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "title_view"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "firstThisSession"
            ],
            "properties": {
              "firstThisSession": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "new_game"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "replacedSave"
            ],
            "properties": {
              "replacedSave": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "chapter_start"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chapter"
            ],
            "properties": {
              "chapter": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "op_start"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "attempt",
              "assists"
            ],
            "properties": {
              "op": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "assists": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "timer",
                  "litanyKey"
                ],
                "properties": {
                  "timer": {
                    "enum": [
                      1,
                      1.5,
                      2
                    ]
                  },
                  "litanyKey": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "op_end"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "result",
              "rank",
              "score",
              "duration",
              "minVitals",
              "counts",
              "maxCombo",
              "litanyUsed",
              "tinctures",
              "assists"
            ],
            "properties": {
              "op": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "result": {
                "enum": [
                  "won",
                  "lost",
                  "quit"
                ]
              },
              "rank": {
                "enum": [
                  "XS",
                  "S",
                  "A",
                  "B",
                  "C"
                ]
              },
              "score": {
                "type": "integer",
                "minimum": 0
              },
              "duration": {
                "type": "number",
                "minimum": 0
              },
              "minVitals": {
                "type": "number",
                "minimum": 0,
                "maximum": 99
              },
              "counts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cool",
                  "good",
                  "bad",
                  "miss"
                ],
                "properties": {
                  "cool": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "good": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "bad": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "miss": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "maxCombo": {
                "type": "integer",
                "minimum": 0
              },
              "litanyUsed": {
                "type": "boolean"
              },
              "tinctures": {
                "type": "integer",
                "minimum": 0
              },
              "assists": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "timer",
                  "litanyKey"
                ],
                "properties": {
                  "timer": {
                    "enum": [
                      1,
                      1.5,
                      2
                    ]
                  },
                  "litanyKey": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "op_fail"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "reason",
              "phase",
              "liveKinds"
            ],
            "properties": {
              "op": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "reason": {
                "enum": [
                  "vitals",
                  "timer",
                  "quit"
                ]
              },
              "phase": {
                "type": "integer",
                "minimum": -1
              },
              "liveKinds": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "rating"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "tool",
              "entity",
              "rating",
              "x",
              "y"
            ],
            "properties": {
              "op": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "tool": {
                "enum": [
                  "lancet",
                  "tongs",
                  "leech",
                  "thread",
                  "salve",
                  "tincture",
                  "brand",
                  "lens"
                ]
              },
              "entity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "rating": {
                "enum": [
                  "cool",
                  "good",
                  "bad",
                  "miss"
                ]
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1280,
                "multipleOf": 32
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 720,
                "multipleOf": 32
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "tool_select"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "tool"
            ],
            "properties": {
              "op": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "tool": {
                "enum": [
                  "lancet",
                  "tongs",
                  "leech",
                  "thread",
                  "salve",
                  "tincture",
                  "brand",
                  "lens"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "story_skip"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "story",
              "line",
              "lines"
            ],
            "properties": {
              "story": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              },
              "lines": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "settings_changed"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "changes"
            ],
            "properties": {
              "changes": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "muted": {
                    "type": "boolean"
                  },
                  "shake": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "timerAssist": {
                    "enum": [
                      1,
                      1.5,
                      2
                    ]
                  },
                  "litanyKey": {
                    "type": "boolean"
                  },
                  "reduceFlashing": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "demo_end_view"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "wishlist_click"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "enum": [
                  "demo_end",
                  "title",
                  "other"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "quit"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scene",
              "sessionSeconds"
            ],
            "properties": {
              "scene": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "sessionSeconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  ]
}
