+    this.fangs.forEach((f, i) => {
+      if (!f.alive) return;
+      const due = i === this.fangs.indexOf(this.due as Embedded);
+      g.text(numerals[i] ?? '', f.origin.x + 16, f.origin.y - 14, { size: due ? 18 : 14, font: 'display', color: hex(due ? '#f0e0a0' : '#a09070', 0.9), align: 'center' });
