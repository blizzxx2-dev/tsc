{
  "name": "suture-and-steel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A grimdark-fantasy surgery action game inspired by the Trauma Center series.",
  "scripts": {
    "dev": "node scripts/build-assets.ts && vite",
    "assets": "node scripts/build-assets.ts",
    "build": "node scripts/build-assets.ts --check && tsc --noEmit && vite build",
    "build:release": "node scripts/build-assets.ts --check && tsc --noEmit && vite build --mode release && node scripts/check-release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n/check-keys.mjs",
    "i18n:validate": "node scripts/i18n/validate.mjs",
    "i18n:glyphs": "node scripts/i18n/glyphs.mjs",
    "i18n:widths": "node scripts/i18n/widths.mjs",
    "i18n:pseudo": "node scripts/i18n/pseudo.mjs",
    "i18n:export": "node scripts/i18n/export.mjs",
    "i18n:import": "node scripts/i18n/import.mjs",
    "i18n:wordcount": "node scripts/i18n/wordcount.mjs",
    "i18n": "npm run i18n:check && npm run i18n:validate && npm run i18n:glyphs && npm run i18n:widths"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "playwright": "1.55",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0"
  }
}
