{
  "name": "suture-and-steel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A grimdark-fantasy surgery action game inspired by the Trauma Center series.",
  "scripts": {
    "dev": "node scripts/build-assets.ts && vite",
    "assets": "node scripts/build-assets.ts",
    "build": "node scripts/build-assets.ts --check && tsc --noEmit && vite build",
    "build:release": "node scripts/build-assets.ts --check && tsc --noEmit && vite build --mode release && node scripts/check-release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n/check-keys.mjs",
    "i18n:validate": "node scripts/i18n/validate.mjs",
    "i18n:glyphs": "node scripts/i18n/glyphs.mjs",
    "i18n:widths": "node scripts/i18n/widths.mjs",
    "i18n:pseudo": "node scripts/i18n/pseudo.mjs",
    "i18n:export": "node scripts/i18n/export.mjs",
    "i18n:import": "node scripts/i18n/import.mjs",
    "i18n:wordcount": "node scripts/i18n/wordcount.mjs",
    "i18n": "npm run i18n:check && npm run i18n:validate && npm run i18n:glyphs && npm run i18n:widths",
    "build:demo": "node scripts/web-build.mjs --edition=demo",
    "build:full": "node scripts/web-build.mjs --edition=full",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:pack": "node scripts/desktop.mjs pack",
    "desktop:smoke": "node scripts/desktop.mjs smoke",
    "check:demo-bundle": "node scripts/check-demo-bundle.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "steam:config": "node scripts/steam-config.mjs",
    "icons": "node scripts/make-icons.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "changelog": "node scripts/changelog.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "test:coverage": "vitest run --coverage --coverage.include=src/surgery/** --coverage.include=src/core/save/** --coverage.include=src/core/save.ts --coverage.reporter=text-summary",
    "prebuild": "npm run -s audio:check",
    "audio:build": "node scripts/audio-build.mjs",
    "audio:check": "node scripts/audio-build.mjs --check && node scripts/audio-loudness.mjs",
    "audio:release-check": "node scripts/audio-build.mjs --release && node scripts/audio-loudness.mjs",
    "audio:events": "node scripts/audio-events-export.mjs",
    "audio:capture": "node scripts/audio-capture.mjs",
    "vo:export": "node scripts/vo-export.mjs",
    "build:qa": "tsc --noEmit && vite build --mode qa --outDir dist-qa",
    "test:unit": "vitest run --project unit",
    "test:sim": "vitest run --project sim",
    "test:e2e": "vitest run --project e2e",
    "test:visual": "vitest run --project visual",
    "visual:update": "node scripts/qa/visual-update.mjs",
    "bench": "vitest bench --project sim --run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check tests scripts/qa scripts/smoke.mjs scripts/shot.mjs src/debug src/telemetry .github eslint.config.js vitest.config.ts commitlint.config.js",
    "smoke": "node scripts/smoke.mjs",
    "shot": "node scripts/shot.mjs",
    "hooks:install": "simple-git-hooks",
    "telemetry:schema": "vite-node scripts/qa/telemetry-schema.ts",
    "test:mutation": "stryker run",
    "balance": "vitest run tests/sweep.test.ts",
    "art:palette": "node scripts/art/palette-export.mjs",
    "art:models": "node scripts/art/build-models.mjs",
    "art:tileable": "node scripts/art/check-tileable.ts",
    "art:export": "node scripts/art/export.ts",
    "predev": "node scripts/art/check-models.mjs",
    "release:checksums": "node scripts/release-checksums.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "ffmpeg-static": "^5.3.0",
    "jpeg-js": "^0.4.4",
    "ktx2-encoder": "^0.4.2",
    "lint-staged": "^17.5.1",
    "node-web-audio-api": "^2.2.0",
    "pixelmatch": "^7.2.0",
    "playwright": "1.55",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "three": "^0.186.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0"
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  },
  "main": "desktop/dist/main.cjs",
  "engines": {
    "node": ">=22.18 <23"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit \"$1\"",
    "pre-push": "node scripts/qa/pre-push.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ]
  }
}
