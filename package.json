{
  "name": "suture-and-steel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A grimdark-fantasy surgery action game inspired by the Trauma Center series.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:demo": "node scripts/web-build.mjs --edition=demo",
    "build:full": "node scripts/web-build.mjs --edition=full",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:pack": "node scripts/desktop.mjs pack",
    "desktop:smoke": "node scripts/desktop.mjs smoke",
    "check:demo-bundle": "node scripts/check-demo-bundle.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "steam:config": "node scripts/steam-config.mjs",
    "icons": "node scripts/make-icons.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "changelog": "node scripts/changelog.mjs",
    "version:bump": "node scripts/version-bump.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "^22.20.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "playwright": "1.55",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0"
  },
  "optionalDependencies": {
    "steamworks.js": "0.4.0"
  },
  "main": "desktop/dist/main.cjs",
  "engines": {
    "node": ">=22.18 <23"
  }
}
