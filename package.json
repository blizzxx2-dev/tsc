{
  "name": "suture-and-steel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A grimdark-fantasy surgery action game inspired by the Trauma Center series.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audio:build": "node scripts/audio-build.mjs",
    "audio:check": "node scripts/audio-build.mjs --check && node scripts/audio-loudness.mjs",
    "audio:release-check": "node scripts/audio-build.mjs --release && node scripts/audio-loudness.mjs",
    "audio:events": "node scripts/audio-events-export.mjs",
    "audio:capture": "node scripts/audio-capture.mjs",
    "vo:export": "node scripts/vo-export.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "ffmpeg-static": "^5.3.0",
    "node-web-audio-api": "^2.2.0",
    "playwright": "1.55",
    "typescript": "~5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0"
  }
}
