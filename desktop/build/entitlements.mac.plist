<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal hardened-runtime entitlements for Electron (PLT-0035): V8's JIT needs allow-jit; nothing else.
  No unsigned-executable-memory, no library-validation exemption (libsteam_api.dylib and the
  steamworks.js .node add-ons are signed with our Developer ID inside the bundle, PLT-0036).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
