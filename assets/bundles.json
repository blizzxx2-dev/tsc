{
  "$comment": "Asset bundles (ENG-0212). An asset id is its path under assets/ without extension (sprite sheets: sprites/<sheet>). The first matching rule (regex on the id) picks its bundle. See docs/assets.md.",
  "bundles": [
    "boot",
    "title",
    "story-common",
    "ops-common",
    "chapter1",
    "chapter2",
    "chapter3",
    "chapter4",
    "chapter5"
  ],
  "rules": [
    {
      "match": "^ui/",
      "bundle": "boot"
    },
    {
      "match": "^fonts/",
      "bundle": "boot"
    },
    {
      "match": "^luts/neutral",
      "bundle": "boot"
    },
    {
      "match": "^(sprites|backdrops|portraits|luts|audio)/ch1-",
      "bundle": "chapter1"
    },
    {
      "match": "^(sprites|backdrops|portraits|luts|audio)/ch2-",
      "bundle": "chapter2"
    },
    {
      "match": "^(sprites|backdrops|portraits|luts|audio)/ch3-",
      "bundle": "chapter3"
    },
    {
      "match": "^(sprites|backdrops|portraits|luts|audio)/ch4-",
      "bundle": "chapter4"
    },
    {
      "match": "^(sprites|backdrops|portraits|luts|audio)/ch5-",
      "bundle": "chapter5"
    },
    {
      "match": "^sprites/(ui|title)",
      "bundle": "title"
    },
    {
      "match": "^(backdrops|portraits)/",
      "bundle": "story-common"
    },
    {
      "match": "^(sprites|particles|audio)/",
      "bundle": "ops-common"
    }
  ],
  "default": "boot",
  "fonts": {
    "atkinson-hyperlegible-latin-400-normal": {
      "family": "Atkinson Hyperlegible",
      "style": "normal",
      "weight": "400"
    },
    "atkinson-hyperlegible-latin-400-italic": {
      "family": "Atkinson Hyperlegible",
      "style": "italic",
      "weight": "400"
    },
    "cinzel-latin-600-normal": {
      "family": "Cinzel",
      "style": "normal",
      "weight": "600",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
    },
    "cinzel-latin-ext-600-normal": {
      "family": "Cinzel",
      "style": "normal",
      "weight": "600",
      "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
    },
    "eb-garamond-latin-500-normal": {
      "family": "EB Garamond",
      "style": "normal",
      "weight": "500",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
    },
    "eb-garamond-latin-500-italic": {
      "family": "EB Garamond",
      "style": "italic",
      "weight": "500",
      "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
    },
    "eb-garamond-latin-ext-500-normal": {
      "family": "EB Garamond",
      "style": "normal",
      "weight": "500",
      "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
    },
    "eb-garamond-latin-ext-500-italic": {
      "family": "EB Garamond",
      "style": "italic",
      "weight": "500",
      "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
    }
  },
  "budgetMB": 150
}
